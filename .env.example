# Groq API keys (comma-separated for automatic rotation on 429/401).
GROQ_API_KEYS=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,gsk_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# Optional: where the gitclaw tool scripts POST to. Defaults to localhost:8000.
# GIT_SENSE_BACKEND_URL=http://localhost:8000

# Optional: run the gitclaw tool fully inline (no HTTP) — useful for CI.
# GIT_SENSE_INLINE=1
